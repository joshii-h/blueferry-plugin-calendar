[BlueFerry Plugin]
Id=io.weirdware.blueferry.calendar
Name=Calendar
Version=0.2.1
ApiVersion=1.3
MinBlueFerry=0.8.1
Capabilities=card;notify;
Homepage=https://github.com/joshii-h/blueferry-plugin-calendar
Source=https://github.com/joshii-h/blueferry-plugin-calendar
Exec=blueferry-calendar serve
Cli=blueferry-calendar
Alias=calendar
ConfigTest=true
ConfigLogin=nextcloud

[ConfigGroup account]
Label=CalDAV account
Help=iCloud, Nextcloud or another CalDAV server. With Nextcloud, "Sign in with Nextcloud" fills in user name and app password for you.

[ConfigGroup feeds]
Label=iCal subscriptions (read-only)
Help=Google Calendar without a sign-in, Outlook.com, iCloud public calendars, holidays, school calendars: any calendar with an iCal address. Shown, never changed. With CalDAV or instead of it.

[Config use_caldav]
Label=Use a CalDAV account
Type=bool
Default=true
Group=account
Help=Off when you only use iCal links (e.g. Google Calendar).

[Config url]
Label=CalDAV server
Type=url
Required=true
Group=account
ShowIf=use_caldav=true
Placeholder=https://caldav.icloud.com
Example=https://cloud.example.org/remote.php/dav
Help=For iCloud always https://caldav.icloud.com.

[Config username]
Label=User name
Type=string
Group=account
ShowIf=use_caldav=true
Placeholder=anna@icloud.com
Help=For iCloud the Apple Account e-mail address.

[Config password]
Label=App password
Type=secret
Required=true
Group=account
ShowIf=use_caldav=true
Help=For iCloud an app-specific password, not your Apple Account password.
HelpUrl=https://support.apple.com/102654

[Config use_ical]
Label=Use iCal links (Google Calendar and others)
Type=bool
Default=false
Group=feeds
Help=Read-only. Google updates these links with a delay (often several hours); changes then show up here too. BlueFerry asks every 15 minutes.

[Config ical_urls]
Label=iCal links
Type=secret
Required=true
Group=feeds
ShowIf=use_ical=true
Placeholder=https://calendar.google.com/calendar/ical/…/private-…/basic.ics
Help=Google: Settings > the calendar > Integrate calendar > Secret address in iCal format. webcal:// works too; several links separated by spaces. Keep it secret: whoever has the link reads the calendar.
HelpUrl=https://support.google.com/calendar/answer/37648

[Config ical_names]
Label=Names of the iCal calendars
Type=string
Group=feeds
ShowIf=use_ical=true
Placeholder=Google, Holidays
Help=Optional, comma-separated in the order of the links; empty uses the name the calendar sends. "Test connection" shows how many events each link has.

[Config calendars]
Label=Calendars
Type=string
Group=options
Placeholder=Personal, Work
ShowIf=use_caldav=true
Help=CalDAV calendars to show, comma-separated; empty shows all. "Test connection" lists the names.

[Config range]
Label=Show
Type=choice
Choices=today;today_tomorrow
Default=today_tomorrow
Group=options
Help=Events of today only, or of today and tomorrow.

[Config reminder]
Label=Reminder
Type=choice
Choices=off;10;15
Default=off
Group=options
Help=A desktop notification this many minutes before an event starts.

[Config hosts]
Label=More allowed hosts
Type=string
Advanced=true
Example=p42-caldav.icloud.com
Help=Other hosts the login or an iCal link may go to, comma-separated (iCloud: the pNN-caldav.icloud.com the check names); empty allows only the hosts you entered.

[Config use_system_proxy]
Label=Use the system proxy
Type=bool
Default=false
Advanced=true
Help=Off connects directly; on sends the requests (and the login) through http(s)_proxy from the environment.

[Config allow_http_feeds]
Label=Allow plain http for iCal links
Type=bool
Default=false
Advanced=true
Help=Only for calendars without https (some club or school sites); the link and the events then travel unencrypted. http to localhost always works.
